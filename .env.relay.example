# CardDAV relay (DMZ host). Copy to .env.relay and adjust; used by compose.relay.yaml.
SECRET_KEY=change-me-to-a-long-random-string
# host name(s) the phones and Kartei use to reach the relay (comma-separated)
ALLOWED_HOSTS=carddav.example.de
# SHA-256 of the push token: Kartei → Settings → CardDAV → "Generate token" shows it. The token itself stays in Kartei.
RELAY_PUSH_TOKEN_SHA256=
# RELAY_PORT=8080
# PROXY_HEADERS=0          # only if phones reach the relay without a reverse proxy (rate limits then use the direct address)
