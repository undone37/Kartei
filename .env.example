# Copy to .env and adjust. Everything else is configured in the web UI (Settings).
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=kartei.example.de,localhost
CSRF_TRUSTED_ORIGINS=https://kartei.example.de
POSTGRES_PASSWORD=change-me

# Initial local admin, created only if no admin exists yet. Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Host directory for CSV/XLSX exports (e.g. a mounted network share)
EXPORT_HOST_DIR=./export_out
# Database backups (Settings -> Backup) go to the Docker volume "backups" unless you set a host directory, ideally on
# other storage than the database (e.g. a NAS mount), never the export share. Owner must be uid 1000.
# BACKUP_HOST_DIR=/mnt/backup/kartei
# WEB_PORT=8000
# Set to 0 only for plain-HTTP local testing (cookies are Secure by default)
# SECURE_COOKIES=1
# PROXY_HEADERS=0          # only if Kartei is reached without the reverse proxy (rate limits then use the direct address)
# X-Forwarded-For/-Proto are believed only from these addresses (your reverse proxy). Default: loopback and Docker
# networks, right for a proxy on the same host. A proxy on another host: add its address, e.g. 10.0.5.10/32
# TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12

# Dedicated PostgreSQL server or cluster instead of the bundled db container (administrator manual, Installation):
# DATABASE_URL=postgres://kartei:PASSWORD@pg.example.de:5432/kartei?sslmode=verify-full&sslrootcert=system
# COMPOSE_FILE=compose.yaml:compose.external-db.yaml
# Link to the source code in the user menu; set it if you run a modified version (AGPL)
# KARTEI_SOURCE_URL=https://github.com/undone37/Kartei
# Prebuilt image instead of building locally (then: docker compose pull && docker compose up -d --no-build)
# KARTEI_IMAGE=ghcr.io/undone37/kartei:0.8.1-beta
# KARTEI_IMAGE=ghcr.io/undone37/kartei:nightly   # current main, for testing only
# CardDAV relay for the DMZ runs on another host: see compose.relay.yaml and .env.relay.example

# Logs: JSON lines by default; LOG_FORMAT=text for plain lines. LOG_LEVEL=INFO (DEBUG, WARNING, ...).
# LOG_FORMAT=json
# Container logs to a SIEM (compose.logging.yaml, Fluent Bit). Kartei's audit events go to syslog from the web UI.
# COMPOSE_FILE=compose.yaml:compose.logging.yaml
# SIEM_HOST=siem.example.de
# SIEM_PORT=6514
# SIEM_MODE=tls              # udp, tcp or tls
# SIEM_TLS=on                # on together with SIEM_MODE=tls
# SIEM_TLS_VERIFY=on
# SIEM_CA_HOST_FILE=./siem-ca.pem             # own CA on the host, then also:
# SIEM_CA_FILE=/fluent-bit/etc/siem-ca.pem
# SIEM_HOSTNAME=kartei       # host name in the syslog header
# SIEM_FACILITY=16           # 16 = local0
# SIEM_SKIP_LOGGERS=^$       # also forward Kartei's audit lines (default skips them: Kartei sends them itself)
