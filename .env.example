# Copy to .env and adjust. Everything else is configured in the web UI (Settings).
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=kartei.example.de,localhost
CSRF_TRUSTED_ORIGINS=https://kartei.example.de
POSTGRES_PASSWORD=change-me

# Initial local admin, created only if no admin exists yet. Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Host directory for CSV/XLSX exports (e.g. a mounted network share)
EXPORT_HOST_DIR=./export_out
# WEB_PORT=8000
# Set to 0 only for plain-HTTP local testing (cookies are Secure by default)
# SECURE_COOKIES=1
# PROXY_HEADERS=0          # only if Kartei is reached without the reverse proxy (rate limits then use the direct address)

# Dedicated PostgreSQL server or cluster instead of the bundled db container (administrator manual, Installation):
# DATABASE_URL=postgres://kartei:PASSWORD@pg.example.de:5432/kartei?sslmode=verify-full&sslrootcert=system
# COMPOSE_FILE=compose.yaml:compose.external-db.yaml
# Link to the source code in the user menu; set it if you run a modified version (AGPL)
# KARTEI_SOURCE_URL=https://github.com/undone37/Kartei
# Prebuilt image instead of building locally (then: docker compose pull && docker compose up -d --no-build)
# KARTEI_IMAGE=ghcr.io/undone37/kartei:0.3.1-beta
# CardDAV relay for the DMZ runs on another host: see compose.relay.yaml and .env.relay.example
